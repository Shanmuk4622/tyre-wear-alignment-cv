# Shared local-only outputs for current and future notebook audits.
# Keep the small completion receipts/manifests at their original locations;
# full HF mirrors, staged publications and copied executions live on HF/local disk.
**/remote/
**/remote_resume/
**/objects/
**/bundle/
**/snapshots/
**/download_cache/
**/executed.ipynb
**/notebook_streams.txt
**/AUDIT.lock
**/VERIFY.lock
**/CONTROLLER.lock
**/NOTEBOOK.lock
**/*.json.lock

# NB10/NB11 engineering runs and NB12 fresh-package/publication fixtures.
tread_two/lc_validation/acceptance_*/
tread_two/lc_validation/nb11_extract_*/
tread_two/lc_validation/upstream/
tread_two/lc_review_validation/acceptance_*/
tread_two/lc_review_validation/fixture_*/
tread_two/lc_review_validation/bundle/

# Large per-observation derivatives are regenerated by NB09/NB12 and published
# as direct CSV on HF. Retain their methods, index, figures and compact summaries.
tread_two/*analysis_report/prediction_audit.csv
tread_two/*analysis_report/reference_contributions.csv
tread_two/*analysis_report/endpoint_patch_evidence.csv
tread_two/*analysis_report/endpoint_patch_support.csv
tread_two/*analysis_report/pooled_reference_affinities.csv
tread_two/*analysis_report/paired_loss_audit.csv
tread_two/*analysis_report/ATLAS_Failure_Explorer.html
tread_two/prototype_report/bank_pixels.csv

# The only NPY files deliberately versioned are small immutable MODEL INPUTS,
# required by FILES.json and notebook builders. These are not trained weights.
!/tread_two/pilot/assets/bank_rgb.npy
!/tread_two/pilot/assets/bank_labels.npy
!/tread_two/lc_pilot/assets/bank_rgb.npy
!/tread_two/lc_pilot/assets/bank_labels.npy
!/tread_two/lc_pilot/assets/bank_valid.npy
!/tread_two/lc_pilot/assets/bank_sha256.npy

